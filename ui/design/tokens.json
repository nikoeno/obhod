{
  "$description": "Obhod design tokens extracted from the clickable MVP (ui/web/style.css). W3C Design Tokens (DTCG) format. Colors have a light and a dark value; the app follows prefers-color-scheme. Sizes in px unless noted; font sizes in rem against the 15px base.",
  "color": {
    "$type": "color",
    "bg":          { "$value": "#ffffff", "$extensions": { "dark": "#1c1c1a" }, "$description": "Window background, inputs, dialogs" },
    "card":        { "$value": "#f1efe8", "$extensions": { "dark": "#2c2c2a" }, "$description": "Cards, side panel, hover fill, code blocks" },
    "border":      { "$value": "#b4b2a9", "$extensions": { "dark": "#5f5e5a" }, "$description": "Dividers, control borders, switch off, idle status dot" },
    "text":        { "$value": "#2c2c2a", "$extensions": { "dark": "#f1efe8" }, "$description": "Body text; toast background" },
    "muted":       { "$value": "#5f5e5a", "$extensions": { "dark": "#b4b2a9" }, "$description": "Secondary text, inactive tabs, table headers" },
    "accent":      { "$value": "#534ab7", "$extensions": { "dark": "#7f77dd" }, "$description": "The one accent: big button, primary button, links, active nav/tab, focus ring, tunnel route" },
    "on-accent":   { "$value": "#ffffff", "$extensions": { "dark": "#1c1c1a" }, "$description": "Text/icon on accent" },
    "accent-soft": { "$value": "rgba(83, 74, 183, 0.14)", "$extensions": { "dark": "rgba(127, 119, 221, 0.18)" }, "$description": "Active nav item, selected table row" },
    "halo":        { "$value": "rgba(83, 74, 183, 0.28)", "$extensions": { "dark": "rgba(127, 119, 221, 0.32)" }, "$description": "Big button halo and pulse" },
    "warn-bg":     { "$value": "#f7ecd2", "$extensions": { "dark": "#3d3420" }, "$description": "Warning banner, warn pill" },
    "warn-text":   { "$value": "#5c430c", "$extensions": { "dark": "#f0d9a0" } },
    "ok-bg":       { "$value": "#dcefe2", "$extensions": { "dark": "#213a2a" }, "$description": "OK pill (e.g. detour server Ready)" },
    "ok-text":     { "$value": "#1f5232", "$extensions": { "dark": "#b5e3c4" } },
    "backdrop":    { "$value": "rgba(0, 0, 0, 0.45)", "$description": "Dialog backdrop, both themes" },
    "route": {
      "direct": { "$value": "#3b7d55", "$extensions": { "dark": "#6dbb8b" }, "$description": "Everyday sites" },
      "tunnel": { "$value": "{color.accent}", "$description": "Blocked sites (same as accent)" },
      "desync": { "$value": "#a86b12", "$extensions": { "dark": "#e0a84a" }, "$description": "Picky sites" },
      "proxy":  { "$value": "#3a6fa8", "$extensions": { "dark": "#79aee3" }, "$description": "Via proxy" },
      "block":  { "$value": "#a8403f", "$extensions": { "dark": "#e07c7a" }, "$description": "Blocked by you; also danger text and 'down' status dot" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Ubuntu", "sans-serif"], "$description": "System font only; no bundled or remote fonts" },
      "mono": { "$value": ["ui-monospace", "Cascadia Mono", "Consolas", "DejaVu Sans Mono", "monospace"] }
    },
    "base":        { "$type": "dimension", "$value": "15px" },
    "line-height": { "$type": "number", "$value": 1.45 },
    "size": {
      "$type": "dimension",
      "h1":       { "$value": "1.5rem" },
      "big-num":  { "$value": "1.4rem", "$description": "Activity stats, tabular-nums" },
      "big-btn":  { "$value": "1.35rem", "$description": "Big button label, weight 700" },
      "h2":       { "$value": "1.1rem" },
      "brand":    { "$value": "1.1rem", "$description": "Weight 700" },
      "subtitle": { "$value": "1.05rem" },
      "h3":       { "$value": "1rem" },
      "body":     { "$value": "1rem" },
      "table":    { "$value": "0.93rem" },
      "md":       { "$value": "0.92rem", "$description": "Card numbers, network line, toast, chart caption" },
      "sm":       { "$value": "0.88rem", "$description": "Small button, card line" },
      "code":     { "$value": "0.86rem" },
      "small":    { "$value": "0.85rem" },
      "xs":       { "$value": "0.82rem", "$description": "Pills, nav status, table headers" },
      "xxs":      { "$value": "0.78rem", "$description": "Tab counts, 'later' badge, tech tag" },
      "tabbar":   { "$value": "0.72rem", "$description": "Mobile bottom tab labels" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Values used in the MVP; not a strict scale",
    "2":  { "$value": "2px" },
    "4":  { "$value": "4px" },
    "6":  { "$value": "6px" },
    "8":  { "$value": "8px" },
    "10": { "$value": "10px" },
    "12": { "$value": "12px" },
    "14": { "$value": "14px" },
    "16": { "$value": "16px" },
    "18": { "$value": "18px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "28": { "$value": "28px" },
    "32": { "$value": "32px" },
    "48": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "4px",   "$description": "Tech tag" },
    "sm":   { "$value": "6px",   "$description": "Focus ring corner, icon button" },
    "md":   { "$value": "8px",   "$description": "Nav item, code block, fieldset, skip link" },
    "lg":   { "$value": "10px",  "$description": "Buttons, inputs, toast" },
    "xl":   { "$value": "12px",  "$description": "Cards, side panel, banner, dialog, charts" },
    "pill": { "$value": "999px" },
    "circle": { "$value": "50%" }
  },
  "border-width": {
    "$type": "dimension",
    "default": { "$value": "1px" },
    "tab":     { "$value": "2px", "$description": "Active tab underline" },
    "ring":    { "$value": "8px", "$description": "Big button inset ring when connected" }
  },
  "shadow": {
    "focus":    { "$type": "string", "$value": "0 0 0 3px {color.bg}, 0 0 0 5px {color.accent}", "$description": "Focus-visible ring: 3px gap in bg, 2px accent" },
    "halo":     { "$type": "string", "$value": "0 0 0 20px {color.halo}" },
    "floating": { "$type": "string", "$value": "0 8px 24px rgba(0, 0, 0, 0.2)", "$description": "Dev panel; use for popovers" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "press":  { "$value": "120ms", "$description": "Big button hover scale" },
      "toggle": { "$value": "150ms", "$description": "Switch track and knob" },
      "state":  { "$value": "200ms", "$description": "Big button background and shadow" },
      "fade":   { "$value": "300ms", "$description": "Toast fade out" },
      "pulse":  { "$value": "1400ms", "$description": "Connecting pulse, ease-in-out, infinite; halo 12px ↔ 26px" },
      "toast":  { "$value": "2800ms", "$description": "Toast visible time before fade; removed at 3200ms" }
    },
    "hover-scale": { "$type": "number", "$value": 1.02 },
    "$description": "prefers-reduced-motion: reduce disables the pulse and all transitions"
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": { "$value": "639px", "$description": "max-width: nav becomes bottom tab bar, cards one column, fan hidden" },
    "split":  { "$value": "899px", "$description": "max-width: Sites side panel stacks above the list" }
  },
  "size": {
    "$type": "dimension",
    "nav-width":       { "$value": "200px" },
    "main-max":        { "$value": "1100px" },
    "home-max":        { "$value": "820px" },
    "sidepanel":       { "$value": "320px" },
    "dialog-max":      { "$value": "680px" },
    "search":          { "$value": "260px" },
    "big-button":      { "$value": "168px" },
    "big-icon":        { "$value": "34px" },
    "nav-icon":        { "$value": "20px" },
    "icon-stroke":     { "$value": "1.8px", "$description": "Nav icons, round caps and joins" },
    "route-dot":       { "$value": "10px" },
    "status-dot":      { "$value": "8px" },
    "brand-dot":       { "$value": "14px" },
    "switch-width":    { "$value": "42px" },
    "switch-height":   { "$value": "24px" },
    "switch-knob":     { "$value": "18px" },
    "fan-height":      { "$value": "44px" },
    "chart-height":    { "$value": "64px" },
    "log-max-height":  { "$value": "340px" }
  },
  "z": {
    "$type": "number",
    "tabbar":   { "$value": 20 },
    "devpanel": { "$value": 40 },
    "skip":     { "$value": 50 },
    "toast":    { "$value": 60 }
  }
}
