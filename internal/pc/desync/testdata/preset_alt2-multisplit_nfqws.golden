--qnum=200
--lua-init=@/opt/zapret/lua/zapret-lib.lua
--lua-init=@/opt/zapret/lua/zapret-antidpi.lua
--uid=0:0
--blob=fake_quic_google:@/opt/zapret/fake/quic_initial_www_google_com.bin
--blob=fake_tls_google:@/opt/zapret/fake/tls_clienthello_www_google_com.bin
--hostlist=hostlist.txt
--filter-udp=443
--payload=quic_initial
--lua-desync=fake:blob=fake_quic_google:repeats=6
--new
--hostlist=hostlist.txt
--filter-tcp=2053,2083,2087,2096,8443
--lua-desync=multisplit:pos=2:seqovl=652:seqovl_pattern=fake_tls_google
--new
--hostlist=hostlist.txt
--filter-tcp=80,443
--lua-desync=multisplit:pos=2:seqovl=652:seqovl_pattern=fake_tls_google
setup:
nft add table inet splitter
nft flush table inet splitter
nft 'add chain inet splitter postrouting { type filter hook postrouting priority 101; }'
nft 'add rule inet splitter postrouting ip daddr { 203.0.113.7/32 } return'
nft 'add rule inet splitter postrouting tcp sport { 50000-50099 } return'
nft 'add rule inet splitter postrouting oifname "eth0" tcp dport { 80, 443, 2053, 2083, 2087, 2096, 8443 } meta mark and 0x40000000 == 0 ct original packets 1-12 queue num 200 bypass'
nft 'add rule inet splitter postrouting oifname "eth0" udp dport { 443 } meta mark and 0x40000000 == 0 ct original packets 1-12 queue num 200 bypass'
nft 'add chain inet splitter output { type filter hook output priority -401; }'
nft 'add rule inet splitter output meta mark and 0x40000000 != 0 notrack'
ip rule add fwmark 0x40000000/0x40000000 lookup main priority 8999
