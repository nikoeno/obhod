--wf-tcp-out=80,443,2053,2083,2087,2096,8443
--wf-udp-out=443
--wf-raw-filter=ifIdx == 9 and (ipv6 or ip.DstAddr != 203.0.113.7) and (not tcp or tcp.SrcPort < 50000 or tcp.SrcPort > 50099)
--lua-init=@C:/app/lua/zapret-lib.lua
--lua-init=@C:/app/lua/zapret-antidpi.lua
--blob=fake_quic_google:@C:/app/fake/quic_initial_www_google_com.bin
--blob=fake_tls_google:@C:/app/fake/tls_clienthello_www_google_com.bin
--hostlist=hostlist.txt
--filter-udp=443
--payload=quic_initial
--lua-desync=fake:blob=fake_quic_google:repeats=6
--new
--hostlist=hostlist.txt
--filter-tcp=2053,2083,2087,2096,8443
--lua-desync=multisplit:pos=2:seqovl=652:seqovl_pattern=fake_tls_google
--new
--hostlist=hostlist.txt
--filter-tcp=80,443
--lua-desync=multisplit:pos=2:seqovl=652:seqovl_pattern=fake_tls_google
requires:
C:/app/fake/quic_initial_www_google_com.bin
C:/app/fake/tls_clienthello_www_google_com.bin
