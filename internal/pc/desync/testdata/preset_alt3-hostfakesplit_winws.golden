--wf-tcp-out=80,443,2053,2083,2087,2096,8443
--wf-udp-out=443
--wf-raw-filter=ifIdx == 9 and not (ip.DstAddr == 203.0.113.7) and not ((tcp.SrcPort >= 50000 and tcp.SrcPort <= 50099))
--lua-init=@C:/app/lua/zapret-lib.lua
--lua-init=@C:/app/lua/zapret-antidpi.lua
--blob=fake_quic_google:@C:/app/fake/quic_initial_www_google_com.bin
--blob=fake_tls_max_ru:@C:/app/fake/tls_clienthello_max_ru.bin
--hostlist=hostlist.txt
--filter-udp=443
--payload=quic_initial
--lua-desync=fake:blob=fake_quic_google:repeats=6
--new
--hostlist=hostlist.txt
--filter-tcp=2053,2083,2087,2096,8443
--payload=tls_client_hello
--lua-desync=fake:blob=fake_default_tls:tcp_ts=-600000:tls_mod=rnd,dupsid,sni=www.google.com
--payload=all
--lua-desync=hostfakesplit:host=www.google.com:nofake1:tcp_ts=-600000
--new
--hostlist=hostlist.txt
--filter-tcp=80,443
--payload=tls_client_hello
--lua-desync=fake:blob=fake_default_tls:tcp_ts=-600000:tls_mod=rnd,dupsid,sni=ya.ru
--payload=http_req
--lua-desync=fake:blob=fake_tls_max_ru:tcp_ts=-600000
--payload=all
--lua-desync=hostfakesplit:host=ya.ru:nofake1:tcp_ts=-600000
requires:
C:/app/fake/quic_initial_www_google_com.bin
C:/app/fake/tls_clienthello_max_ru.bin
