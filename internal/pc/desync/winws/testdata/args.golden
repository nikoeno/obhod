--wf-tcp-out=80,443
--wf-raw-filter=ifIdx == 12 and (ipv6 or ip.DstAddr != 203.0.113.7) and (ip or ipv6.DstAddr != 2001:db8::7) and (not tcp or tcp.SrcPort < 50000 or tcp.SrcPort > 50099)
